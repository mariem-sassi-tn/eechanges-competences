# --- Serveur ---
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200
# Mettre à 1 derrière nginx / un reverse proxy
TRUST_PROXY=0

# --- Base MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=echanges_competences

# --- JWT (en production : 32+ caractères aléatoires) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-longue-valeur-aleatoire
JWT_EXPIRES_IN=8h

# --- Recommandation (ml-service). Vide = pas de badge de compatibilité ---
ML_SERVICE_URL=
# ML_TIMEOUT_MS=5000
# ML_MIN_SCORE=15

# --- E-mail (code de réinitialisation). Vide = affiché en console en dev ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TalentXchange <no-reply@echanges.local>"

# --- Assistant IA du support (clé conservée uniquement côté serveur) ---
# Option gratuite recommandée : clé Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# Option payante (utilisée seulement si GEMINI_API_KEY est vide)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
